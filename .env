# Mapbox Access Token (optional - will use public demo token if not provided)
# Get your free token at: https://account.mapbox.com/access-tokens/
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here

# Google Maps and Solar API Key
# Get your API key at: https://console.cloud.google.com/google/maps-apis
# Make sure to enable both "Maps JavaScript API" and "Solar API"

# ElevenLabs Text-to-Speech API Key (optional - will fallback to Web Speech API)
# Get your API key at: https://elevenlabs.io/app/speech-synthesis/text-to-speech
# Used for high-quality AI voice narration in the 3D campus tour
# If not provided, the tour will use browser's built-in Web Speech API
REACT_APP_ELEVENLABS_API_KEY=sk_821463e6110c98e4a420ad823ebbf1858baf93223e6c35aa
