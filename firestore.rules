rules_version = '2';

// Firestore Security Rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Blog posts collection
    match /blogs/{postId} {
      // Anyone authenticated can read published posts
      allow read: if isAuthenticated();

      // Only admins can create, update, or delete blog posts
      allow create, update, delete: if isAdmin();
    }

    // Map layers collection
    match /map-layers/{layerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // GeoPackages collection
    match /geopackages/{gpkgId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Sustainability data collection
    match /sustainability-data/{dataType}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit log collection
    match /audit-log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
